# Public site URL (canonical links, sitemap, Open Graph)
NEXT_PUBLIC_SITE_URL=https://www.svaruvezu.com

# Payments: mock | stripe   (see lib/payments)
PAYMENT_PROVIDER=mock
STRIPE_SECRET_KEY=

# Address autocomplete: mock | google | mapbox   (see lib/geo)
GEO_PROVIDER=mock
GOOGLE_MAPS_API_KEY=
MAPBOX_ACCESS_TOKEN=

# Admin panel (/admin). Login is disabled until ADMIN_PASSWORD is set.
ADMIN_PASSWORD=
# Signs the admin session cookie (long random string, e.g. `openssl rand -hex 32`)
ADMIN_SECRET=

# Storage. Without DATABASE_URL data goes to .data/db.json (local dev only).
DATABASE_URL=
# Media uploads on Vercel (Vercel Blob). Without it files go to .data/uploads.
BLOB_READ_WRITE_TOKEN=
